{
  "name": "@farmclaw/desktop-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "scripts": {
    "build:dashboard": "npm --prefix ../farmclaw-dashboard run build",
    "build:shell": "node ./scripts/build.mjs",
    "build": "npm run build:dashboard && npm run build:shell",
    "typecheck": "tsc --noEmit",
    "test": "node --test ./src/*.test.ts",
    "smoke:dsh": "node ./scripts/smoke-dsh.mjs",
    "start": "node ./scripts/start.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "electron": "44.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
