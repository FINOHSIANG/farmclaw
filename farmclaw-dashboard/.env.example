# 默认免费地图：无需申请 Key
VITE_MAP_PROVIDER=openfreemap
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# 可选：切换为 amap 时才需要申请
# VITE_MAP_PROVIDER=amap
# 申请地址：https://console.amap.com/dev/key/app
VITE_AMAP_KEY=

# Farmclaw 本地网关地址
VITE_FARMCLAW_WS_URL=ws://127.0.0.1:18789

# 可选：允许加载的跨域摄像头 HTTPS 来源，多个来源用逗号分隔。
# 默认仅允许与看板同源的 http(s) 媒体；不要填写带账号、令牌或路径的地址。
VITE_TWIN_MEDIA_ALLOWED_ORIGINS=

# 部署在子路径时填写，例如 /farmclaw/
VITE_APP_BASE_URL=/
